{
  "name": "@node-in-layers/llm",
  "type": "module",
  "version": "1.0.0",
  "description": "Standardized OpenAI-compatible LLM access for Node In Layers systems.",
  "main": "index.js",
  "scripts": {
    "build": "rm -Rf ./dist && tsgo -p ./tsconfig.json && cp package.json ./dist && cp README.md ./dist",
    "build:watch": "nodemon -e '*' --watch ./src --exec \"npm run build || exit 1\"",
    "commit": "cz",
    "dist": "npm run build && cd dist && npm publish",
    "eslint": "eslint .",
    "feature-tests": "./node_modules/.bin/cucumber-js -p default",
    "prettier": "prettier --write .",
    "prettier:check": "prettier -c .",
    "test": "mocha -r tsx ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts",
    "test:coverage": "nyc --all --reporter cobertura --reporter text --reporter lcov --reporter html mocha -r ./test/register-instrument.cjs ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "external-editor": {
      "tmp": ">=0.2.6"
    },
    "commitizen": {
      "lodash": ">=4.17.24",
      "inquirer": {
        "external-editor": {
          "tmp": ">=0.2.6"
        }
      }
    },
    "mocha": {
      "diff": ">=8.0.3",
      "serialize-javascript": ">=7.0.5"
    },
    "sinon": {
      "diff": ">=8.0.3"
    },
    "@cucumber/cucumber": {
      "tmp": ">=0.2.6"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai-as-promised": "^8.0.1",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/lodash": "^4.17.13",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.19.20",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@typescript/native-preview": "^7.0.0-dev.20260604.1",
    "argparse": "",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-functional": "~7.1.0",
    "eslint-plugin-import": "^2.31.0",
    "esprima": "^4.0.1",
    "globals": "^15.12.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.7",
    "nyc": "^17.1.0",
    "prettier": "^3.3.3",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.1",
    "sinon-chai": "^3.5.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/openai": "^1.8.4",
    "@node-in-layers/core": "^1.18.3",
    "@node-in-layers/secrets": "^1.1.0",
    "zod": "^4.6.7"
  }
}
